# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
/.angular
# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules

# profiling files
chrome-profiler-events*.json
speed-measure-plugin*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db
/src/assets/config.yaml
/src/assets/config.yaml
/src/assets/config.yaml
data/
node_modules/
dist/

# Room data backups (too large for GitHub)
data/rooms/*.backup*

# Secrets & certs
.env
*.pem
*.key
*token*
*password*
*secret*
VPSサーバー設定/
ローカルサーバー設定/
data/
backups/*.pem.bak
検証ファイル/

# -----------------------------------------------------------------------------
# Udonarium_syn ローカル作業領域
# -----------------------------------------------------------------------------
# 比較候補はそれぞれ独立したGitリポジトリです。
# 親のLycorisリポジトリへ誤って取り込まないよう、候補本体を無視します。
/candidates/*/

# 一時クローン、API応答、展開物など、作り直せる調査データを置きます。
/.work/

# 検証中に生成される大容量・端末依存・秘密情報を含み得るデータです。
/validation/artifacts/
/validation/runtime/
/validation/fixtures/private/
/validation/*.local.*
